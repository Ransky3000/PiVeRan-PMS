ndow.addEventListener("scroll",o,!0),window.addEventListener("resize",o),()=>{window.removeEventListener("scroll",o,!0),window.removeEventListener("resize",o),null!=i.current&&cancelAnimationFrame(i.current)}},[e,t,a]),n}let ag=e=>"prompt"===e.command.handler.type,am=({command:e})=>({kind:"command",command:e});function ah(e,t,a){for(let n=t;n>=0&&n<e.length;n+=a)if("command"===e[n].kind)return n;return -1}var ap=e.i(836944),af=e.i(228273),av=e.i(727017),ay=e.i(89741),a_=e.i(543764),ab=e.i(404959),ax=e.i(795327);let aw=Object.keys(ax.ENDPOINT_MAP),ak=Object.keys(ax.BUILTIN_FUNCTIONS),aT=["line","bar","stacked_percentage","area","pie","donut","sparkline"],aj=["String","Float","DateTime","Int","Bool","JSON","NULL"],aI=["sum","avg","max","min","count","first_value"],aC=["ms","s","min","duration","credits","usd","eur","inr","ratio","rating"],aS=["voice_id_to_name","model_to_name","product_type_to_name","hashed_xi_api_key_to_name","user_id_to_name","user_id_to_email","webhook_id_to_name","webhook_type_to_name","agent_id_to_name","language_code_to_name","concurrency_queue_to_name","evaluation_status_to_label","resource_id_to_name","fiat_charge_type_to_name","knowledge_base_document_id_to_name","billing_group_id_to_name","reporting_workspace_id_to_name"],aN=["agent_branch_id_to_name","agent_workflow_node_id_to_name"],aA=["agent-config","agent-config-agent","agent-config-branches","agent-config-workflow","agent-config-knowledge-base","agent-config-analysis","agent-config-coaching","agent-config-tools","agent-config-tests","agent-config-guardrails","agent-config-settings"],aR=[{name:"start",icon:eK.FileTextIcon,intrinsicIcon:!0,description:{id:"mC0J7J",message:"Set up this agent's context (agents.md) so I know your goals"},keywords:["setup","onboard","agents.md","context","begin","brief"],relevantPageIds:[...aA,"speech-engine-config","agent-coaching"],handler:{type:"message",contextInjection:()=>"The user wants to set up this agent's agents.md context document — the background you receive at the start of every conversation about this agent. It guides how you help build the agent; it does NOT change the agent's own runtime behavior or prompt. 1) Ask a few concise questions (use suggest_quick_reply_options): what the agent is for, who it serves, the tone/voice, the domain or business, and any team conventions or constraints you should always keep in mind. 2) Draft a short, well-structured markdown agents.md from their answers. 3) Save it with overwrite_string_field (target agent_md) when writing it fresh, or append_to_string_field / edit_string_field (target agent_md) to extend or refine an existing one — read_string_field first when editing. 4) Confirm what you saved and remind them it will be reused automatically next time, and that they can edit it anytime in the Agent context panel."},condition:e=>e.hasAgent&&!e.hasArchitectAgentContext},{name:"generate",icon:o.NavConversationalAIAgentsIcon,description:{id:"2wzffD",message:"Generate a new agent from a description"},keywords:["new","create","build","agent"],relevantPageIds:["agents-list","dashboard"],handler:{type:"message",contextInjection:()=>"The user wants to generate a new agent from a description. Help them refine their description if needed, then call generate_agent via async_execute_agents_tool. It runs in the background -- keep the conversation going while it generates (ask about voice preferences, deployment plans, etc.). When the result arrives as a contextual update, navigate the user to the new agent and offer to walk them through the configuration. Then help them set up the agent's agents.md context (its purpose, tone, domain, and team conventions) and save it with overwrite_string_field (target agent_md), so you have that background in every future conversation about this agent."}},{name:"debug",icon:o.NavConversationHistoryIcon,description:{id:"Ch6MpL",message:"Debug recent failed conversations"},keywords:["failed","conversations","errors","fix","transcripts"],relevantPageIds:["agent-history","history","conversation-detail"],handler:{type:"message",contextInjection:()=>"The user wants to debug their agent. Proactively: 1) Use list_conversations to find the last 5-10 failed conversations for the current agent. 2) Use get_conversation_detail on each to read the transcripts. 3) Identify common patterns — tool failures, wrong transitions, missing KB answers, garbled ASR. 4) Summarize the top 2-3 issues with specific evidence from the transcripts. 5) Suggest concrete fixes (prompt changes, tool config, KB additions) and offer to apply them."},condition:e=>e.hasAgent},{name:"test",icon:o.NavConversationalAITestsIcon,description:{id:"CEtUia",message:"Run tests and summarize results"},keywords:["tests","run","qa","checks","results"],relevantPageIds:["agent-testing","agent-testing-runs"],handler:{type:"message",contextInjection:()=>"The user wants to run the tests attached to the current agent. 1) Use get_agent_config to read platform_settings.testing.attached_tests — these are the test_ids actually wired to the agent. If the array is empty, tell the user no tests are attached and stop (don't fall back to list_tests, which returns workspace-wide tests). 2) Call run_tests with the agent_id and the attached test_ids. It returns { invocation_id }. 3) Pass that value as test_invocation_id to get_test_suite_summary. If the run is still pending, wait a few seconds and call get_test_suite_summary again until it terminates. 4) Summarize: how many passed, how many failed, and for each failure name the criterion and quote the failure detail. 5) If there are failures, suggest specific fixes."},condition:e=>e.hasAgent},{name:"explain",icon:af.BubbleWideIcon,intrinsicIcon:!0,description:{id:"iZ-pQh",message:"Explain what this agent does in plain English"},keywords:["describe","summary","what does","overview"],relevantPageIds:[...aA,"speech-engine-config"],handler:{type:"message",contextInjection:()=>"The user wants a clear, plain English explanation of the current agent. 1) Use get_agent_config to read the full configuration. 2) Describe in 3-5 paragraphs: what the agent does (purpose, use case), how it works (workflow structure, key decision points), what tools it uses and why, what knowledge base content it draws from, and any notable configuration choices (LLM, voice, guardrails). 3) Keep it non-technical — suitable for a product manager or new team member. 4) Flag anything unusual or potentially problematic."},condition:e=>e.hasAgent},{name:"optimize",icon:a_.SettingsSliderHorIcon,intrinsicIcon:!0,description:{id:"FrzGnt",message:"Suggest prompt and config improvements"},keywords:["improve","tune","prompt","performance","perf","config"],relevantPageIds:[...aA,"speech-engine-config"],handler:{type:"message",contextInjection:()=>"The user wants optimization suggestions for the current agent. 1) Use get_agent_config to read the full configuration. 2) Analyze the system prompt — check for: missing sections (personality, tone, guardrails), vague instructions, flow descriptions that belong in workflow nodes, excessive length. 3) Check the LLM choice — is it appropriate for the complexity? Could a cheaper/faster model work? Is the cascade configured well? 4) Check tools — are descriptions clear enough for the LLM? Are tools properly scoped to workflow nodes? 5) Check knowledge base — are there obvious content gaps? 6) Present 3-5 ranked suggestions with expected impact. Offer to apply each one."},condition:e=>e.hasAgent},{name:"rollback",icon:ay.RotateCcwIcon,intrinsicIcon:!0,description:{id:"EzS1th",message:"Review recent config changes and undo if needed"},keywords:["undo","revert","restore","changes","history"],relevantPageIds:[...aA,"speech-engine-config"],excludeFromSuggestions:!0,handler:{type:"message",contextInjection:()=>"The user wants to review and potentially roll back recent agent configuration changes. 1) Use get_agent_config to read the current configuration. 2) Explain to the user that you can see the current state and help them identify what changed if they describe the issue. 3) Ask what specifically seems wrong or different. 4) If they identify something to revert, use update_agent_config to restore the previous values. 5) Confirm the change and offer to run tests to verify."},condition:e=>e.hasAgent},{name:"clear",icon:ab.TrashIcon,intrinsicIcon:!0,description:{id:"tahG0s",message:"Clear this conversation and start fresh"},keywords:["reset","new","restart","fresh"],handler:{type:"action"}},{name:"feedback",icon:af.BubbleWideIcon,intrinsicIcon:!0,description:{id:"fYCzfd",message:"Send private feedback about this session (not shared with the agent)"},keywords:["report","bug","issue","suggestion"],handler:{type:"action"}},{name:"branch",icon:o.NavConversationalAIBranchesIcon,description:{id:"YUXfSK",message:"Create a new branch for this agent"},keywords:["fork","copy","variant","version"],relevantPageIds:[...aA,"speech-engine-config"],handler:{type:"message",contextInjection:()=>"The user wants to create a new branch of the current agent to test changes safely. 1) Read the current config with get_agent_config. 2) Help them describe what they want to change. 3) Use create_branch to create the branch. You can pass conversation_config or platform_settings overrides directly when creating the branch. 4) After creating the branch, use switch_branch to navigate to it. 5) Offer to set up a traffic split for A/B testing."},condition:e=>e.hasAgent},{name:"experiment",icon:av.LabIcon,intrinsicIcon:!0,description:{id:"07HQk6",message:"Create a branch and deploy it as an A/B test"},keywords:["ab","a/b","split","test","traffic","deploy"],relevantPageIds:[...aA,"agent-analytics","speech-engine-config"],handler:{type:"message",contextInjection:()=>"The user wants to create an A/B experiment. Walk them through: 1) Use get_agent_config to read the current setup. 2) Help them describe the hypothesis — what change do they think will improve performance? 3) Create a new branch with the proposed changes. 4) Help them decide on a traffic split (recommend starting at 10% for the experiment branch). 5) Explain how to monitor the results in the evaluation dashboard. 6) Remind them to change only one variable at a time so they can attribute any differences."},condition:e=>e.hasAgent},{name:"review",icon:o.NavConversationalAIAnalyticsIcon,description:{id:"I7inhx",message:"Review agent performance and find improvements"},keywords:["performance","perf","scorecard","analytics","metrics"],relevantPageIds:["agent-analytics","agent-history","history"],handler:{type:"message",contextInjection:()=>"The user wants a performance review of the current agent. Proactively: 1) Use list_conversations to get recent conversations for this agent, including both successful and failed ones. 2) Check test results if tests exist (list_tests, then list_test_runs and get_test_suite_summary for the latest run). 3) Read the agent config to understand the setup (get_agent_config). 4) Analyze: success rate, common failure patterns, average conversation length, tool call success rates. 5) Compare the agent's configuration against best practices — prompt structure, LLM choice, cascade setup, tool descriptions, knowledge base coverage. 6) Present a scorecard with 3-5 specific improvement opportunities ranked by expected impact, and offer to implement each one."},condition:e=>e.hasAgent},{name:"remember",icon:ap.BrainIcon,intrinsicIcon:!0,description:{id:"rZimPH",message:"Teach this agent to remember a fact"},keywords:["memory","fact","learn","teach","knowledge","memorize"],relevantPageIds:[...aA,"agent-coaching"],handler:{type:"message",contextInjection:()=>"The user wants to teach the agent a new fact or piece of knowledge. Memory entries are facts the agent can recall during conversations — like a customer's preferences, product details, or operational rules. 1) Ask the user what fact or knowledge they want the agent to remember. Help them articulate it clearly if needed. 2) Once you have a clear fact, use create_memory_entry to add it to the agent's coaching memory base. The 'text' field should contain the fact in a form optimized for semantic search (this is what the agent uses to find relevant memories). Optionally add a 'summary' (brief label for the UI) and 'notes' (internal context about why this memory was added). 3) After creating the memory, confirm it was saved and explain that the agent will now be able to recall this fact when relevant topics come up in conversations. 4) Offer to add more memories or test how the agent uses this knowledge. Check the '...adding agent memory items' procedure."},condition:e=>e.hasAgent},{name:"dashboard",icon:o.NavConversationalAIDashboardIcon,description:{id:"Hj3H_w",message:"Create a custom analytics dashboard"},keywords:["analytics","chart","metrics","report","visualize"],relevantPageIds:["agent-analytics","dashboard"],handler:{type:"message",contextInjection:()=>`The user wants to create a custom analytics dashboard. You have access to a powerful dashboard DSL that lets you build charts, tables, and metrics from real-time data.

The current time is ${Date.now()} (Unix milliseconds), which is ${new Date().toISOString()}. Use this to compute correct DateTime param defaults.

${`
# Dashboard DSL Specification

You create dashboards using a JSON-based DSL. A dashboard has three parts:
- params: Dynamic values the user can control (filters, date range)
- data_sources: Where data comes from (API endpoints)
- root: UI element tree

## Value System

Every dynamic value in the DSL is a Value object. Types:

\`\`\`
Literal: { type: "literal", value: <js_value> }
Param ref: { type: "dashboard_param", name: "<param_name>" }
Column ref: { type: "data_source_column", data_source: "<id>", column: "<col>" }
Row column: { type: "row_column", column: "<col>" } (only in derived columns)
Expression: { type: "expression", left: Value, right: Value, operator: "<op>" }
Ternary: { type: "ternary", condition: Value<Bool>, if_true: Value, if_false: Value }
Function: { type: "function_result", function: "<name>", args: Value[] }
Metric: { type: "data_source_metric", data_source: "<id>", metric: Metric }
Is error: { type: "is_error", value: Value }
\`\`\`

Value types: ${aj.join(", ")} (and array variants like String[], Int[])

Expression operators: ${[...ax.EXPRESSION_OPERATORS].join(", ")}

Built-in functions: ${ak.join(", ")}
- formatDate(DateTime) → String (locale date)
- isoFormatDate(DateTime) → String (ISO)
- size(Array) → Int
- concat(String, String, ...) → String
- stringify(any) → String
- singleton(T) → T[] (wrap in array)

## Params

\`\`\`
{ type: "<ValueType>", name: "<name>", default: <value|null>, unit?: "<ColumnUnit>" }
\`\`\`

Column units: ${aC.join(", ")}

## Data Sources

Only "endpoint" type. Each has an id, endpoint name, params, optional filters, optional derived_columns.

\`\`\`
{
  type: "endpoint", id: "<unique_id>", endpoint: "<endpoint_name>",
  params: { start_time: Value, end_time: Value, interval_seconds: Value, group_by: Value<String[]>, ... },
  filters?: [ ArrayFilter | ComparisonFilter, ... ],
  derived_columns?: [ { column_name: "<name>", column_type: "<type>", derivation: RowScopedValue } ]  // only: row_column, expression, ternary, literal, function_result, is_error
}
\`\`\`

Available endpoints: ${aw.join(", ")}

Filter operators: array: ${[...ax.FILTER_OPERATORS].join(", ")} | comparison: ${[...ax.COMPARISON_OPERATORS].join(", ")}

ArrayFilter: { type: "array_filter", column: Value<String>, operation: Value<String>, values: Value<ArrayType> }
ComparisonFilter: { type: "comparison_filter", column: Value<String>, operation: Value<String>, value: Value }

### Key Endpoint Columns

agents_conversations_over_time: timestamp, cnt (call count), cost (credits), llm_cost (USD), duration (seconds), avg_rating, rating_count. Groupable/filterable columns: agent_id, branch_id, success, language, text_only, is_burst, phone_call_direction, transfer_to_number, environment
agents_latency_over_time: timestamp, p25, p50, p75, p95, sample_count. Groupable: event_name, agent_id, branch_id. Filter event_name to: TTS_TTF_AUDIO_SINCE_SILENCE (agent response time), LLM_TTFT (LLM latency), RAG_LATENCY (RAG latency)
agents_concurrency_over_time: timestamp, max_concurrency, min_concurrency. Groupable: agent_id, branch_id, success, language, etc.
agents_rating_over_time: timestamp, avg_rating, rating_count. Groupable: agent_id, branch_id, text_only, is_burst, phone_call_direction, transfer_to_number, environment
agents_tools_over_time: timestamp, total_count, error_count, error_rate, avg_latency. Groupable: agent_id, tool_type, tool_name
agents_llm_error_rate: timestamp, total_llm_requests, fallback_count, error_rate
agents_rag_documents_over_time: timestamp, reference_count. Groupable: agent_id, knowledge_base_document_id, rag_embedding_model
requests_by_response_code_and_path: timestamp, path_pattern, response_code, method, count, hashed_xi_api_key, user_id
request_latency_over_time: timestamp, path_pattern, p50, p90, p99
usage_by_product_over_time: timestamp, product_type, credits, characters, count
webhook_calls_over_time: timestamp, webhook_id, webhook_type, status, count

## Elements

### chart
\`\`\`
{
  type: "chart", chartType: Value<String>, title: "<title>", data_source: "<ds_id>",
  dimension: Value<String>, breakdown_dimensions: Value<String[]>,
  metrics: [ { metric: Metric, title?: string, unit?: ColumnUnit, colors?: Record<string,string> } ],
  mappers?: Record<string, Mapper>, topK?: Value<Int>,
  allowLogScale?: Value<Bool>, cumulative?: Value<Bool>, height?: "xs"|"md",
  headerDisplay?: ValueDisplay, hide?: Value<Bool>
}
\`\`\`
Chart types: ${aT.join(", ")}

### Metrics
SimpleMetric: { type: "simple_metric", row_value: Value, operator: "<agg_op>", row_weight?: Value<Float>, row_filter?: Value<Bool> }
SplitMetric: { type: "split_metric", group_by: Value<String[]>, group_value: Metric, operator: "<agg_op>", group_weight?: Metric }
Aggregation operators: ${aI.join(", ")}

### bars
\`\`\`
{ type: "bars", title: Value<String>, data_source: "<ds_id>", dimensions: Value<String[]>, metric: Metric, topKInline?: Value<Int>, mappers?: Record<string,Mapper>, unit?: ColumnUnit }
\`\`\`

### table
\`\`\`
{ type: "table", data_source: Value<String>, visible_columns?: Value<String[]>, mappers?: Record<string,Mapper> }
\`\`\`

### value_display
\`\`\`
{ type: "value_display", title: "<title>", value: Value, unit?: ColumnUnit, tooltip?: string, description?: string, deltaComparisonValue?: Value<Float>, deltaTooltip?: string, deltaPositiveIsGood?: boolean }
\`\`\`

### Layout elements
- linear_flow: { type: "linear_flow", elements: Element[], gap?: 2|4|6 }
- split_flow: { type: "split_flow", elements: Element[] } (side-by-side)
- tile: { type: "tile", variant: "backdrop"|"solid", content: Element }
- tabs: { type: "tabs", tabs: [{ id: string, buttonContent: Element, content: Element }] }
- text: { type: "text", value: Value<String>, size: "xs"|"sm"|"md"|"lg" }
- controls_row: { type: "controls_row", chips: Input[] }

### Inputs (for controls_row)
- time_range_input: { type: "time_range_input", start_controls: Value<String>, end_controls: Value<String>, preset_controls?: Value<String>, interval_controls?: Value<String> }
- dropdown_input: { type: "dropdown_input", id: string, title: Value<String>, controls: Value<String>, values: Value<ArrayType>, multiple?: Value<Bool> }
- text_input: { type: "text_input", id: string, title: Value<String>, controls: Value<String> }
- multi_filter: { type: "multi_filter", controls: Value<String>, filters: (DropdownInput | TextInput)[] }
- toggle_input: { type: "toggle_input", controls: Value<String>, title: Value<String> }

## Mappers

Transform raw values for display:
- Static: { type: "static", mapping: { "raw": "Display Name" } }
- Special (server-resolved): { type: "special", name: "<mapper_name>" }
  Names: ${aS.join(", ")}
- Parameterized: { type: "parameterized", name: "<name>", parameter: Value<String> }
  Names: ${aN.join(", ")}

## Example: Line chart of agent latency over time

\`\`\`json
{
  "params": [
    { "type": "DateTime", "name": "start_date", "default": ${Date.now()-6048e5} },
    { "type": "DateTime", "name": "end_date", "default": ${Date.now()} },
    { "type": "Int", "name": "interval_seconds", "default": 86400 },
    { "type": "String", "name": "time_range_preset", "default": "week" },
    { "type": "String[]", "name": "group_by", "default": [] }
  ],
  "data_sources": [
    {
      "type": "endpoint", "id": "latency", "endpoint": "agents_latency_over_time",
      "params": {
        "start_time": { "type": "dashboard_param", "name": "start_date" },
        "end_time": { "type": "dashboard_param", "name": "end_date" },
        "interval_seconds": { "type": "dashboard_param", "name": "interval_seconds" },
        "group_by": { "type": "dashboard_param", "name": "group_by" }
      },
      "filters": [
        { "type": "array_filter", "column": { "type": "literal", "value": "event_name" }, "operation": { "type": "literal", "value": "in" }, "values": { "type": "literal", "value": ["TTS_TTF_AUDIO_SINCE_SILENCE"] } }
      ]
    }
  ],
  "root": {
    "type": "linear_flow", "elements": [
      { "type": "controls_row", "chips": [
        { "type": "time_range_input", "start_controls": { "type": "literal", "value": "start_date" }, "end_controls": { "type": "literal", "value": "end_date" }, "preset_controls": { "type": "literal", "value": "time_range_preset" }, "interval_controls": { "type": "literal", "value": "interval_seconds" } }
      ] },
      { "type": "tile", "variant": "solid", "content": {
        "type": "chart", "chartType": { "type": "literal", "value": "line" }, "title": "Agent Response Time",
        "data_source": "latency", "dimension": { "type": "literal", "value": "timestamp" },
        "breakdown_dimensions": { "type": "dashboard_param", "name": "group_by" },
        "metrics": [{ "title": "p50 Latency", "metric": { "type": "simple_metric", "row_value": { "type": "row_column", "column": "p50" }, "operator": "first_value" }, "unit": "s" }]
      }}
    ]
  }
}
\`\`\`

## Important Notes
- All date values are Unix timestamps in milliseconds
- interval_seconds controls time bucketing granularity (e.g. 3600=hourly, 86400=daily)
- To filter by agent, use an array_filter on "agent_id" column with "in" operation
- To compare branches, add "branch_id" to group_by and use agent_branch_id_to_name parameterized mapper
- controls_row "controls" values are param names (strings), not param references
- Use execute_agents_tool with tool_name "create_dashboard" to render the dashboard inline once you've built it
`.trim()}

Steps:
1) Clarify what the user wants to visualize — which metrics, time range, filters, comparisons.
2) Build a valid DashboardRepresentation JSON following the DSL spec above.
3) Use execute_agents_tool with tool_name "create_dashboard", passing name and the definition JSON string as args. The dashboard is rendered for the user — inline in the full-screen builder (where several dashboards can sit side by side), or in a modal in the sidebar. Emit one create_dashboard call per dashboard; consecutive ones lay out together in a row.

Always include a time range control (controls_row with time_range_input) so the user can adjust the date range. Default to the last 7 days using time_range_preset "week". When the user asks for a custom time range (e.g. "last 75 days"), set the preset to "custom" and compute the start_date and end_date defaults accordingly.`}}],aE=[],aM=(0,j.forwardRef)(({search:e,onSelect:t,onClose:a,filter:n,extraCommands:s},o)=>{let{i18n:l,_:c}=(0,r.useLingui)(),d=function(e,t,a=aE){let n=(0,eb.usePathname)(),s=(0,eb.useParams)(),i=(0,ad.useAgentPageContext)(),[r]=(0,E.useLocalStorage)(E.LocalStorageKeys.SUPPORT_CHAT_RECENT_COMMANDS,[]),[o]=(0,E.useLocalStorage)(E.LocalStorageKeys.SUPPORT_CHAT_COMMAND_FREQUENCY,{}),l=i.getPageContext()?.pageId??null,c=s?.agentId??n?.match(/\/app\/agents\/agents\/([^/]+)/)?.[1],d=(0,M.useGetArchitectAgentContextRoute)({pathParams:{agentId:c??""}},{enabled:!!c,retry:!1}),u=d.isLoading||d.isError||(d.data?.content??"").trim().length>0;return(0,j.useMemo)(()=>{var n,s;let i,d,g={hasAgent:!!c,hasArchitectAgentContext:u,pageId:l};return n=[...aR.filter(e=>(!e.condition||e.condition(g))&&(!t||t(e))),...a],s={pageId:l,recent:r,frequency:o},i=e.trim().length>0,(d=n.map((t,a)=>{let n=i?function(e,t){let a=t.trim().toLowerCase();if(!a)return 0;let n=e.name.toLowerCase();if(n===a)return 1e3;if(n.startsWith(a))return 800;let s=(e.keywords??[]).map(e=>e.toLowerCase());return s.some(e=>e.startsWith(a))?600:n.includes(a)?400:300*!!s.some(e=>e.includes(a))}(t,e):0,r=function(e,t){var a;let n;return e.excludeFromSuggestions?0:((a=t.pageId)?500*!!e.relevantPageIds?.includes(a):0)+(-1===(n=t.recent.indexOf(e.name))?0:Math.max(0,120-20*n))+Math.min(60,(t.frequency[e.name]??0)*6)}(t,s);return{command:t,text:n,score:n+r,boost:r,index:a}}).filter(e=>!i||e.text>0)).sort((e,t)=>t.score-e.score||e.index-t.index),d.map(e=>({command:e.command,boosted:e.boost>0}))},[c,u,l,e,r,o,t,a])}(e,n,s),g=(0,ad.useAgentPageContext)(),m=Y(),h=(0,j.useRef)(null),p=(0,j.useRef)(null),f=au(h