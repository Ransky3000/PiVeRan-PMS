      "updated": 1786798262300,
      "link": null,
      "locked": false,
      "text": "Table: Job_order\n\nFields:\n\n- JO_id\n\n- Owner                                       (Enum → owner_id.Name)\n\n- Vehicle                                 (Enum → owner_id.Vehicles)\n\n- Vehicle Photo                            (owner_id.Vehicles.Photo)\n\n- Odometer                      \n\n- Service_type                        (Enum → bundle_id.bundle_name)\n\n- Service_description                           (bundle_id.Interval)\n\n- DVI_checklist                            (Enumlist → CD_id)\n\n- Incharge             (Enumlist → user_id.Name | Filter \"Mechanic\")\n\n- Status: (Enum)\n        - \"New\"\n        - \"Work in progress\"\n        - \"Job Completed\"",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Table: Job_order\n\nFields:\n\n- JO_id\n\n- Owner                                       (Enum → owner_id.Name)\n\n- Vehicle                                 (Enum → owner_id.Vehicles)\n\n- Vehicle Photo                            (owner_id.Vehicles.Photo)\n\n- Odometer                      \n\n- Service_type                        (Enum → bundle_id.bundle_name)\n\n- Service_description                           (bundle_id.Interval)\n\n- DVI_checklist                            (Enumlist → CD_id)\n\n- Incharge             (Enumlist → user_id.Name | Filter \"Mechanic\")\n\n- Status: (Enum)\n        - \"New\"\n        - \"Work in progress\"\n        - \"Job Completed\"",
      "autoResize": false,
      "lineHeight": 1.25
    },
